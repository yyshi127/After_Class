# AfterClass environment template
# Copy this file to .env for local development or to your deployment environment.
# Never commit real secrets, API keys, production database URLs, or private storage credentials.

# PostgreSQL connection used by Prisma and the application.
DATABASE_URL="postgresql://afterclass:replace-with-db-password@localhost:5432/afterclass_dev?schema=public"

# Application URL and secret. Generate AUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="replace-with-32-byte-random-secret"
NEXTAUTH_SECRET="replace-with-32-byte-random-secret"

# AI provider configuration. Use disabled/mock locally unless a provider is explicitly configured.
AI_PROVIDER="mock"
AI_API_KEY="replace-with-provider-api-key-or-leave-unset"
AI_BASE_URL=""
AI_MODEL=""

# Private file storage. Keep check-in photos and homework images out of public web paths.
STORAGE_PATH="./storage"
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Docker Compose overrides.
WEB_PORT="3000"
POSTGRES_DB="afterclass"
POSTGRES_USER="afterclass"
POSTGRES_PASSWORD="replace-with-db-password"
POSTGRES_PORT="5432"

# Optional operational controls.
LOG_LEVEL="info"
AUDIT_LOG_ENABLED="true"
AI_AUDIT_LOG_ENABLED="true"
